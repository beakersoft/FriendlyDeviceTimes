{
    "manifest_version": 3,
    "name": "Family Link Time Printer",
    "version": "1.0.0",
    "description": "Print a wall-friendly timetable of your child's Family Link device time.",
    "permissions": [
        "scripting",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://families.google.com/familylink/*",
        "https://familylink.google.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://families.google.com/familylink/*",
                "https://familylink.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": [
                "https://families.google.com/familylink/*",
                "https://familylink.google.com/*"
            ],
            "js": [
                "interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_popup": "",
        "default_title": "Open printable timetable",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "interceptor.js"
            ],
            "matches": [
                "https://families.google.com/*",
                "https://familylink.google.com/*"
            ]
        }
    ]
}